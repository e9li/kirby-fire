{
    "name": "e9li/kirby-fire",
    "description": "Generate cache with command",
    "type": "kirby-plugin",
    "license": "MIT",
    "version": "0.2.1",
    "authors": [
        {
            "name": "Rafael Egli",
            "email": "rafael@e9li.com",
            "homepage": "https://www.e9li.com"
        }
    ],
    "support": {
        "docs": "https://git.e9li.com/e9li/kirby-fire/src/branch/main/README.md",
        "source": "https://git.e9li.com/e9li/kirby-fire",
        "issues": "https://github.com/e9li/kirby-fire/issues"
    },
    "keywords": [
        "kirby",
        "kirby-cms",
        "kirby-plugin",
        "cache"
    ],
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "getkirby/composer-installer": true
        }
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0",
        "getkirby/composer-installer": "^1.2",
        "symfony/http-client": "^7.0",
        "symfony/browser-kit": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "getkirby/cms": "^5.2"
    },
    "autoload-dev": {
        "psr-4": {
            "E9li\\Fire\\Tests\\": "tests/"
        }
    },
    "extra": {
        "kirby-cms-path": false
    },
    "scripts": {
        "test": "phpunit"
    }
}
